# ==============================================================================
# Project LUMIA: Curated Showcase Repository .gitignore
# Security, Large Binary Prevention, and Clean Open-Source Distribution Policy
# ==============================================================================

# --- Python & Build Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments & Interpreters ---
.venv/
venv/
ENV/
env/
.python-version-dev

# --- Environment Variables, Secrets & API Tokens ---
.env
.env.*
*.env
*.pem
*.key
*.cert
*.pfx
*.p12
secrets.yaml
secrets.json
credentials.json
api_keys.json

# --- Testing, Linting & Type Checking Caches ---
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/
.tox/
.nox/

# --- IDEs, Editor Workbenches & OS Clutter ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*.tmp
.awb/

# --- Large Astronomical Datasets & Scientific Binaries ---
# Strictly prevent multi-gigabyte telescope archives from leaking into Git history
*.fits
*.fits.gz
*.fts
*.fit
*.h5
*.hdf5
*.zarr/
*.zarr
worker_*.zarr/
worker_*.zarr
*.parquet
*.feather
*.arrow
*.orc
data/
data/*

# --- NASA NAIF SPICE Planetary & Ephemeris Kernels ---
# Large binary ephemerides must be dynamically provisioned via automated fetch tools
*.bsp
*.tls
*.tpc
*.bds
*.tf
*.ti
*.bc
data/spice/

# --- Machine Learning Checkpoints & Weights ---
*.pt
*.pth
*.bin
*.ckpt
*.safetensors
*.onnx
checkpoints/
models_cache/
runs/
wandb/

# --- Analytical & Transactional Database Files ---
*.duckdb
*.duckdb.wal
*.duckdb.tmp
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.sql
*.dump

# --- Frontend Node & Build Artifacts ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Logs, Profiling & Diagnostics ---
*.log
logs/
*.prof
*.pstats
tmp/
temp/
scratch/

# --- Internal Agentic Scaffolding, WIP Scratchpads & Backlogs ---
# The public repository must remain clean and authoritative. Exclude internal meta-files:
.agents/
.agentrules.md
*DRIFT_REPORT*.md
*drift_report*.md
concepts_brief.md
design_draft.md
BACKLOG.md
backlog.md
lastenheft.md
docs/lastenheft.md
docs/backlog.md